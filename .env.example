# ==============================================================================
# AGRI-NOVA Environment Configuration
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/agrinova_db?schema=public"

# Authentication Security (Min 32 characters for production)
JWT_SECRET="your_ultra_secure_jwt_secret_key_minimum_32_chars_long"

# AI Service Microservice URL
NEXT_PUBLIC_AI_URL="http://localhost:8000"

# Application Environment
NODE_ENV="production"
PORT=3000
